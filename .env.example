# ========== Chaos Cartel env vars ==========
# Copy to .env for local dev. Railway auto-injects DATABASE_URL from the
# Postgres plugin; set the others in Railway → Variables.

# --- Database ---
# Local: matches docker-compose.yml credentials
# Railway: leave blank, Railway injects this automatically
DATABASE_URL=postgres://chaoscartel:chaoscartel_dev@localhost:5432/chaoscartel

# --- Stripe ---
# Set STRIPE_SECRET_KEY to your live sk_live_... key to activate real payments.
# When STRIPE_SECRET_KEY is unset, the app runs in PREVIEW MODE (no real charges).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Sessions ---
# Long random secret. Generate: `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string

# --- App ---
APP_BASE_URL=http://localhost:5000
NODE_ENV=development
PORT=5000

# --- Admin ---
# CHANGE THESE FOR PRODUCTION
ADMIN_USERNAME=admin
ADMIN_PASSWORD=chaoscartel
